.iss-main-grid,
.disp-main-grid {
  width: 100% !important;

  gap: 8px !important;

  margin: 0 !important;
}


/* ============================================================
   CARTES
   ============================================================ */

.acq-zone,
.iss-zone,
.disp-zone {
  width: 100% !important;

  border-radius: 10px !important;
}


.acq-zone-head,
.iss-zone-head,
.disp-zone-head {
  height: 45px !important;
  min-height: 45px !important;

  padding:
    0
    14px
    0
    55px !important;
}


.acq-zone-head h3,
.iss-zone-head h3,
.disp-zone-head h3 {
  margin: 0 !important;

  font-size: 16px !important;
  line-height: 1 !important;
}


/* ============================================================
   NUMEROS DE ZONES
   ============================================================ */

.acq-number,
.iss-number,
.disp-number {
  width: 48px !important;
  height: 48px !important;

  left: -7px !important;
  top: -4px !important;

  font-size: 23px !important;
}


/* ============================================================
   CORPS DES ZONES
   ============================================================ */

.acq-zone-body,
.iss-zone-body,
.disp-zone-body {
  padding:
    9px
    13px
    8px !important;
}


/* ============================================================
   KPI
   ============================================================ */

.acq-kpis,
.iss-kpis,
.disp-kpis {
  gap: 8px !important;
}


.acq-kpis.four,
.iss-kpis.four,
.disp-kpis.four {
  grid-template-columns:
    repeat(4, 1fr) !important;
}


.acq-kpi,
.iss-kpi,
.disp-kpi {
  min-height: 58px !important;

  padding:
    7px
    9px !important;
}


.acq-kpi span,
.iss-kpi span,
.disp-kpi span {
  font-size: 9px !important;
}


.acq-kpi strong,
.iss-kpi strong,
.disp-kpi strong {
  font-size: 21px !important;
  line-height: 1 !important;
}


.acq-kpi small,
.iss-kpi small,
.disp-kpi small {
  font-size: 8px !important;
}


/* ============================================================
   BLOCS 3 / 4 / 5
   ============================================================ */

.acq-bottom-zones,
.iss-bottom-zones,
.disp-bottom-zones {
  grid-template-columns:
    1.05fr
    1.02fr
    .85fr !important;

  gap: 8px !important;

  margin-top: 7px !important;
}


.acq-bottom-card,
.iss-bottom-card,
.disp-bottom-card {
  min-height: 105px !important;

  padding:
    10px
    12px
    8px
    48px !important;
}


.acq-bottom-content h3,
.iss-bottom-content h3,
.disp-bottom-content h3 {
  font-size: 15px !important;
}


.acq-bottom-content ul,
.iss-bottom-content ul,
.disp-bottom-content ul {
  font-size: 9px !important;
  line-height: 1.3 !important;
}


.acq-bottom-content p,
.iss-bottom-content p,
.disp-bottom-content p {
  font-size: 10px !important;
}


/* ============================================================
   KPI BAS
   ============================================================ */

.acq-summary-kpis,
.iss-summary-kpis,
.disp-summary-kpis {
  grid-template-columns:
    repeat(5, 1fr) !important;

  gap: 9px !important;

  margin-top: 10px !important;
}


.acq-summary-kpis article,
.iss-summary-kpis article,
.disp-summary-kpis article {
  min-height: 64px !important;

  padding:
    8px
    12px !important;

  grid-template-columns:
    40px
    1fr
    auto !important;
}


.acq-summary-icon,
.iss-summary-icon,
.disp-summary-icon {
  width: 36px !important;
  height: 36px !important;

  font-size: 20px !important;
}


.acq-summary-kpis span,
.iss-summary-kpis span,
.disp-summary-kpis span {
  font-size: 10px !important;
}


.acq-summary-kpis strong,
.iss-summary-kpis strong,
.disp-summary-kpis strong {
  font-size: 22px !important;
}


/* ============================================================
   TABLE
   ============================================================ */

.acq-table-card,
.iss-table-card,
.disp-table-card {
  margin-top: 9px !important;

  padding:
    8px
    11px !important;
}


.acq-table-card table,
.iss-table-card table,
.disp-table-card table {
  font-size: 9px !important;
}


/* ============================================================
   INTERDICTION DES SCALES LOCAUX
   ============================================================ */

.iss-page,
.iss-page *,
.disp-page,
.disp-page * {
  transform: none !important;
}


/* ============================================================
   NAVIGATION DETAIL - DECALAGE DES BOUTONS
   ACQ / ISS / DISP
   ============================================================ */

.acq-brand,
.iss-brand,
.disp-brand {
  width: 370px !important;
  min-width: 370px !important;
  max-width: 370px !important;
}

.acq-program,
.iss-program,
.disp-program {
  min-width: 190px !important;

  margin-right: 18px !important;

  font-size: 16px !important;
  font-weight: 800 !important;

  white-space: nowrap !important;
}

.acq-nav,
.iss-nav,
.disp-nav {
  margin-left: 18px !important;

  gap: 12px !important;
}

.acq-nav a,
.iss-nav a,
.disp-nav a {
  min-width: auto !important;

  padding: 0 16px !important;

  height: 40px !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  white-space: nowrap !important;
}


/* ============================================================
   HEADER DETAIL - ALIGNEMENT STRICT ACQ / ISS / DISP
   ============================================================ */

.acq-topbar,
.iss-topbar,
.disp-topbar {
  display: grid !important;

  grid-template-columns:
    122px
    1px
    210px
    auto !important;

  column-gap: 20px !important;

  align-items: center !important;

  height: 64px !important;
  min-height: 64px !important;

  padding: 0 22px !important;
}


/* logo */

.acq-logo,
.iss-logo,
.disp-logo {
  width: 122px !important;
  height: 42px !important;

  object-fit: contain !important;
}


/* séparateur */

.acq-separator,
.iss-separator,
.disp-separator {
  width: 1px !important;
  height: 31px !important;

  margin: 0 !important;

  background: #cfdae6 !important;
}


/* Programme ESTREEM */

.acq-program,
.iss-program,
.disp-program {
  width: 210px !important;
  min-width: 210px !important;
  max-width: 210px !important;

  margin: 0 !important;

  font-size: 16px !important;
  font-weight: 800 !important;

  white-space: nowrap !important;
}


/* navigation */

.acq-nav,
.iss-nav,
.disp-nav {
  margin: 0 !important;

  height: 64px !important;

  display: flex !important;
  align-items: center !important;

  gap: 14px !important;
}


/* boutons */

.acq-nav a,
.iss-nav a,
.disp-nav a {
  min-width: auto !important;

  height: 40px !important;

  padding: 0 16px !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  font-size: 14px !important;
  line-height: 1 !important;

  white-space: nowrap !important;
}


/* ============================================================
   FIX HEADER DETAIL - RETOUR FLEX STABLE
   ============================================================ */

.acq-topbar,
.iss-topbar,
.disp-topbar {
  display: flex !important;
  align-items: center !important;

  height: 64px !important;
  min-height: 64px !important;

  padding: 0 22px !important;
}


/* BRAND */

.acq-brand,
.iss-brand,
.disp-brand {
  display: flex !important;
  align-items: center !important;

  width: auto !important;
  min-width: auto !important;
  max-width: none !important;

  flex: 0 0 auto !important;
}


.acq-logo,
.iss-logo,
.disp-logo {
  width: 122px !important;
  height: 42px !important;

  flex: 0 0 122px !important;

  object-fit: contain !important;
}


.acq-separator,
.iss-separator,
.disp-separator {
  width: 1px !important;
  height: 31px !important;

  margin: 0 20px !important;

  flex: 0 0 1px !important;
}


/* PROGRAMME */

.acq-program,
.iss-program,
.disp-program {
  width: auto !important;
  min-width: 190px !important;
  max-width: none !important;

  margin: 0 26px 0 0 !important;

  flex: 0 0 190px !important;

  font-size: 16px !important;
  font-weight: 800 !important;

  white-space: nowrap !important;
}


/* NAVIGATION */

.acq-nav,
.iss-nav,
.disp-nav {
  display: flex !important;
  align-items: center !important;

  flex: 1 1 auto !important;

  height: 64px !important;

  margin: 0 !important;

  gap: 12px !important;
}


.acq-nav a,
.iss-nav a,
.disp-nav a {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  flex: 0 0 auto !important;

  min-width: auto !important;

  height: 40px !important;

  padding: 0 16px !important;

  font-size: 14px !important;

  white-space: nowrap !important;
}


/* ============================================================
   V2 - ALIGNEMENT ECHELLE ISS / DISP SUR ACQ
   HOME + ACQ = REFERENCES, NE PAS MODIFIER
   ============================================================ */


/* ------------------------------------------------------------
   1. CONTENEUR PAGE
   ------------------------------------------------------------ */

.iss-page,
.disp-page {
  width: 100% !important;
  max-width: none !important;

  padding:
    14px
    clamp(28px, 3vw, 55px)
    28px !important;
}


/* ------------------------------------------------------------
   2. TITRE PAGE
   ------------------------------------------------------------ */

.iss-page-head,
.disp-page-head {
  margin-bottom: 16px !important;
}

.iss-page-head h1,
.disp-page-head h1 {
  font-size: 30px !important;
  line-height: normal !important;
}


/* ------------------------------------------------------------
   3. CARTE REPORT
   ------------------------------------------------------------ */

.iss-main-card,
.disp-main-card {
  padding: 9px !important;
}


/* ------------------------------------------------------------
   4. GRILLE PRINCIPALE
   ACQ = 1fr / 1fr
   ------------------------------------------------------------ */

.iss-main-grid,
.disp-main-grid {
  display: grid !important;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr) !important;

  gap: 10px !important;
}


/* Empêche le contenu ISS/DISP d'élargir les colonnes */

.iss-main-grid > *,
.disp-main-grid > * {
  min-width: 0 !important;
}


/* ------------------------------------------------------------
   5. ZONES PRINCIPALES
   ------------------------------------------------------------ */

.iss-zone-head,
.disp-zone-head {
  min-height: 48px !important;

  padding:
    0
    14px
    0
    58px !important;
}

.iss-zone-head h3,
.disp-zone-head h3 {
  font-size: 19px !important;
}

.iss-zone-body,
.disp-zone-body {
  padding:
    11px
    17px
    9px !important;
}


/* ------------------------------------------------------------
   6. NUMEROS 1 / 2
   ------------------------------------------------------------ */

.iss-number,
.disp-number {
  width: 54px !important;
  height: 54px !important;

  font-size: 28px !important;
}


/* ------------------------------------------------------------
   7. KPI INTERNES
   ------------------------------------------------------------ */

.iss-kpis,
.disp-kpis {
  gap: 8px !important;
}

.iss-kpis.four,
.disp-kpis.four {
  grid-template-columns:
    repeat(4, minmax(0, 1fr)) !important;
}

.iss-kpi,
.disp-kpi {
  min-width: 0 !important;

  padding:
    8px
    12px !important;
}

.iss-kpi span,
.disp-kpi span {
  font-size: 10px !important;
}

.iss-kpi strong,
.disp-kpi strong {
  font-size: 24px !important;
}

.iss-kpi small,
.disp-kpi small {
  font-size: 9px !important;
}


/* ------------------------------------------------------------
   8. ZONES 3 / 4 / 5
   ------------------------------------------------------------ */

.iss-bottom-zones,
.disp-bottom-zones {
  display: grid !important;

  grid-template-columns:
    minmax(0, 1.05fr)
    minmax(0, 1.02fr)
    minmax(0, .85fr) !important;

  gap: 10px !important;

  margin-top: 9px !important;
}

.iss-bottom-zones > *,
.disp-bottom-zones > * {
  min-width: 0 !important;
}


/* ------------------------------------------------------------
   9. KPI DE SYNTHESE
   Même norme desktop qu'ACQ : 5 KPI
   ------------------------------------------------------------ */

.iss-summary-kpis,
.disp-summary-kpis {
  display: grid !important;

  grid-template-columns:
    repeat(5, minmax(0, 1fr)) !important;

  gap: 12px !important;

  margin-top: 12px !important;
}

.iss-summary-kpis article,
.disp-summary-kpis article {
  min-width: 0 !important;
  min-height: 75px !important;

  padding:
    10px
    17px !important;

  grid-template-columns:
    48px
    minmax(0, 1fr)
    auto !important;
}


/* ------------------------------------------------------------
   10. TABLE
   ------------------------------------------------------------ */

.iss-table-card,
.disp-table-card {
  margin-top: 11px !important;

  padding:
    10px
    14px !important;
}

.iss-table-card table,
.disp-table-card table {
  width: 100% !important;

  font-size: 11px !important;
}


/* ------------------------------------------------------------
   RESPONSIVE
   IMPORTANT :
   les règles 1 colonne ne doivent s'appliquer
   que sur petit écran.
   ------------------------------------------------------------ */

@media (max-width: 900px) {

  .iss-main-grid,
  .disp-main-grid,
  .iss-bottom-zones,
  .disp-bottom-zones {
    grid-template-columns: 1fr !important;
  }

  .iss-summary-kpis,
  .disp-summary-kpis {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
  }
}


/* ============================================================
   ALIGNEMENT FINAL ISS / CONTESTATION SUR ACQ
   ACQ + HOME = REFERENCES
   ============================================================ */


/* ============================================================
   PAGE
   ============================================================ */

.iss-page,
.disp-page {
  width: 100% !important;
  max-width: none !important;

  padding:
    14px
    40px
    26px !important;

  margin: 0 !important;
}


/* ============================================================
   TITRE DE PAGE
   ============================================================ */

.iss-page-head,
.disp-page-head {
  min-height: 59px !important;
  margin-bottom: 10px !important;
}

.iss-page-head h1,
.disp-page-head h1 {
  margin: 0 !important;

  font-size: 26px !important;
  line-height: 1.1 !important;

  font-weight: 800 !important;
}

.iss-page-head p,
.disp-page-head p {
  margin: 5px 0 0 !important;

  font-size: 13px !important;
}


/* ============================================================
   CARTE PRINCIPALE
   ============================================================ */

.iss-main-card,
.disp-main-card {
  width: 100% !important;

  padding: 8px !important;

  margin: 0 !important;

  border-radius: 10px !important;
}


/* ============================================================
   TITRE REPORT
   ============================================================ */

.iss-report-title,
.disp-report-title {
  min-height: 38px !important;

  grid-template-columns:
    36px
    1fr
    auto !important;
}

.iss-report-title h2,
.disp-report-title h2 {
  margin: 0 !important;

  font-size: 19px !important;
  line-height: 1.1 !important;
}


/* ============================================================
   RESUME EXECUTIF
   ============================================================ */

.iss-summary-text,
.disp-summary-text {
  margin:
    3px
    36px
    8px !important;

  padding:
    7px
    10px !important;

  font-size: 10px !important;
  line-height: 1.3 !important;
}


/* ============================================================
   GRILLE PRINCIPALE
   MEME EQUILIBRE QUE ACQ
   ============================================================ */

.iss-main-grid,
.disp-main-grid {
  display: grid !important;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr) !important;

  gap: 8px !important;
}

.iss-main-grid > *,
.disp-main-grid > * {
  min-width: 0 !important;
}


/* ============================================================
   TITRES DES ZONES
   ============================================================ */

.iss-zone-head,
.disp-zone-head {
  min-height: 45px !important;

  padding:
    0
    14px
    0
    55px !important;
}

.iss-zone-head h3,
.disp-zone-head h3 {
  margin: 0 !important;

  font-size: 16px !important;
  line-height: 1 !important;
}


/* ============================================================
   NUMEROS 1 / 2
   ============================================================ */

.iss-number,
.disp-number {
  width: 48px !important;
  height: 48px !important;

  font-size: 23px !important;
}


/* ============================================================
   CORPS DES ZONES
   ============================================================ */

.iss-zone-body,
.disp-zone-body {
  padding:
    9px
    13px
    8px !important;
}


/* ============================================================
   KPI PRINCIPAUX
   ============================================================ */

.iss-kpis,
.disp-kpis {
  gap: 8px !important;
}

.iss-kpis.four,
.disp-kpis.four {
  grid-template-columns:
    repeat(4, minmax(0, 1fr)) !important;
}

.iss-kpi,
.disp-kpi {
  min-width: 0 !important;
  min-height: 58px !important;

  padding:
    7px
    9px !important;
}

.iss-kpi span,
.disp-kpi span {
  font-size: 9px !important;
}

.iss-kpi strong,
.disp-kpi strong {
  font-size: 21px !important;
  line-height: 1 !important;
}

.iss-kpi small,
.disp-kpi small {
  font-size: 8px !important;
}


/* ============================================================
   ZONES 3 / 4 / 5
   ============================================================ */

.iss-bottom-zones,
.disp-bottom-zones {
  display: grid !important;

  grid-template-columns:
    minmax(0, 1.05fr)
    minmax(0, 1.02fr)
    minmax(0, .85fr) !important;

  gap: 8px !important;

  margin-top: 7px !important;
}

.iss-bottom-card,
.disp-bottom-card {
  min-height: 105px !important;

  padding:
    10px
    12px
    8px
    48px !important;
}

.iss-bottom-content h3,
.disp-bottom-content h3 {
  font-size: 15px !important;
}

.iss-bottom-content ul,
.disp-bottom-content ul {
  font-size: 9px !important;
  line-height: 1.3 !important;
}

.iss-bottom-content p,
.disp-bottom-content p {
  font-size: 10px !important;
}


/* ============================================================
   KPI DE SYNTHESE
   ============================================================ */

.iss-summary-kpis,
.disp-summary-kpis {
  grid-template-columns:
    repeat(5, minmax(0, 1fr)) !important;

  gap: 9px !important;

  margin-top: 10px !important;
}

.iss-summary-kpis article,
.disp-summary-kpis article {
  min-width: 0 !important;
  min-height: 64px !important;

  padding:
    8px
    12px !important;

  grid-template-columns:
    40px
    minmax(0, 1fr)
    auto !important;
}

.iss-summary-icon,
.disp-summary-icon {
  width: 36px !important;
  height: 36px !important;

  font-size: 20px !important;
}

.iss-summary-kpis span,
.disp-summary-kpis span {
  font-size: 10px !important;
}

.iss-summary-kpis strong,
.disp-summary-kpis strong {
  font-size: 22px !important;
}


/* ============================================================
   TABLEAUX
   ============================================================ */

.iss-table-card,
.disp-table-card {
  margin-top: 9px !important;

  padding:
    8px
    11px !important;
}

.iss-table-card table,
.disp-table-card table {
  font-size: 9px !important;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 900px) {

  .iss-main-grid,
  .disp-main-grid,
  .iss-bottom-zones,
  .disp-bottom-zones {
    grid-template-columns: 1fr !important;
  }

  .iss-summary-kpis,
  .disp-summary-kpis {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
  }
}


/* ============================================================
   CALIBRAGE VISUEL FIXE DES PAGES
   HOME + ACQ = REFERENCES
   ============================================================ */

:root {
  --iss-zoom: 0.92;
  --disp-zoom: 0.92;
}


/* ------------------------------------------------------------
   EMISSION
   ------------------------------------------------------------ */

.iss-page {
  zoom: var(--iss-zoom) !important;

  width:
    calc(100% / var(--iss-zoom)) !important;

  max-width: none !important;
}


/* ------------------------------------------------------------
   CONTESTATION
   ------------------------------------------------------------ */

.disp-page {
  zoom: var(--disp-zoom) !important;

  width:
    calc(100% / var(--disp-zoom)) !important;

  max-width: none !important;
}


/* Le header et le breadcrumb restent à 100 % */

.iss-topbar,
.iss-breadcrumb,
.disp-topbar,
.disp-breadcrumb {
  zoom: 1 !important;
}


/* ============================================================
   ECHELLE GLOBALE PAGES DETAIL
   Meme norme que la Home
   ============================================================ */

html {
  zoom: 1 !important;
}

body {
  zoom: 0.75 !important;

  width: 133.333333% !important;
  max-width: none !important;

  margin: 0 !important;
}


/* Annulation des anciens zooms locaux */

.acq-page,
.iss-page,
.disp-page {
  zoom: 1 !important;

  width: 100% !important;
  max-width: none !important;

  transform: none !important;
}


/* neutralisation anciens calibrages domaine */

:root {
  --iss-zoom: 1 !important;
  --disp-zoom: 1 !important;
}

.iss-page,
.disp-page {
  zoom: 1 !important;
  width: 100% !important;
}


/* ============================================================
   CORRECTION ECHELLE PAGES DETAIL
   ACQ / ISS / DISP
   ============================================================ */

html,
body {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  margin: 0 !important;

  overflow-x: hidden !important;
}

body {
  zoom: 0.85 !important;
}

/* annule l'ancien width 133.333% */
body {
  width: 100% !important;
}

.acq-topbar,
.iss-topbar,
.disp-topbar,
.acq-breadcrumb,
.iss-breadcrumb,
.disp-breadcrumb,
.acq-page,
.iss-page,
.disp-page {
  width: 100% !important;
  max-width: 100% !important;

  box-sizing: border-box !important;
}


/* aucun zoom supplémentaire par domaine */

.acq-page,
.iss-page,
.disp-page {
  zoom: 1 !important;

  transform: none !important;
}


/* neutralisation anciens paramètres */

:root {
  --iss-zoom: 1 !important;
  --disp-zoom: 1 !important;
}


/* Zoom CSS unique - ACQ / ISS / Contestation */
html,
body {
  zoom: 1 !important;
  transform: none !important;

  width: 100% !important;
  max-width: 100% !important;

  overflow-x: hidden !important;
}

.acq-page,
.iss-page,
.disp-page {
  zoom: 1 !important;
  transform: none !important;

  width: 100% !important;
  max-width: 100% !important;
}

:root {
  --iss-zoom: 1 !important;
  --disp-zoom: 1 !important;
}
