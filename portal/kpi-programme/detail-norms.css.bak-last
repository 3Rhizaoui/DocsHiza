  min-height: 39px !important;

  padding: 8px 14px !important;

  font-size: 12px !important;

  border-radius: 8px !important;
}


/* ============================================================
   CARTE PRINCIPALE
   ============================================================ */

.acq-main-card,
.iss-main-card,
.disp-main-card {
  width: 100% !important;

  padding: 8px !important;

  margin: 0 !important;

  border-radius: 10px !important;
}


/* ============================================================
   TITRE REPORT
   ============================================================ */

.acq-report-title,
.iss-report-title,
.disp-report-title {
  min-height: 38px !important;

  grid-template-columns:
    36px
    1fr
    auto !important;
}


.acq-report-title h2,
.iss-report-title h2,
.disp-report-title h2 {
  font-size: 19px !important;
  line-height: 1.1 !important;
}


/* ============================================================
   TEXTE EXECUTIF
   ============================================================ */

.acq-summary-text,
.iss-summary-text,
.disp-summary-text {
  margin:
    3px
    36px
    8px !important;

